s{/privacy}","received_events_url":"https://api.github.com/users/Juwon-Ogunseye/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T20:19:47Z","updated_at":"2026-09-28T20:19:47Z","body":"i will work on this ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5877760653/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"Juwon-Ogunseye","id":60205286,"node_id":"MDQ6VXNlcjYwMjA1Mjg2","avatar_url":"https://avatars.githubusercontent.com/u/60205286?v=4","gravatar_id":"","url":"https://api.github.com/users/Juwon-Ogunseye","html_url":"https://github.com/Juwon-Ogunseye","followers_url":"https://api.github.com/users/Juwon-Ogunseye/followers","following_url":"https://api.github.com/users/Juwon-Ogunseye/following{/other_user}","gists_url":"https://api.github.com/users/Juwon-Ogunseye/gists{/gist_id}","starred_url":"https://api.github.com/users/Juwon-Ogunseye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Juwon-Ogunseye/subscriptions","organizations_url":"https://api.github.com/users/Juwon-Ogunseye/orgs","repos_url":"https://api.github.com/users/Juwon-Ogunseye/repos","events_url":"https://api.github.com/users/Juwon-Ogunseye/events{/privacy}","received_events_url":"https://api.github.com/users/Juwon-Ogunseye/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5879911077","html_url":"https://github.com/apache/airflow/issues/73861#issuecomment-5879911077","issue_url":"https://api.github.com/repos/apache/airflow/issues/73861","id":5879911077,"node_id":"IC_kwDOAgUK288AAAABXnhSpQ","user":{"login":"Juwon-Ogunseye","id":60205286,"node_id":"MDQ6VXNlcjYwMjA1Mjg2","avatar_url":"https://avatars.githubusercontent.com/u/60205286?v=4","gravatar_id":"","url":"https://api.github.com/users/Juwon-Ogunseye","html_url":"https://github.com/Juwon-Ogunseye","followers_url":"https://api.github.com/users/Juwon-Ogunseye/followers","following_url":"https://api.github.com/users/Juwon-Ogunseye/following{/other_user}","gists_url":"https://api.github.com/users/Juwon-Ogunseye/gists{/gist_id}","starred_url":"https://api.github.com/users/Juwon-Ogunseye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Juwon-Ogunseye/subscriptions","organizations_url":"https://api.github.com/users/Juwon-Ogunseye/orgs","repos_url":"https://api.github.com/users/Juwon-Ogunseye/repos","events_url":"https://api.github.com/users/Juwon-Ogunseye/events{/privacy}","received_events_url":"https://api.github.com/users/Juwon-Ogunseye/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-28T22:30:39Z","updated_at":"2026-09-28T22:30:39Z","body":"Here's my proposed approach, which keeps #67657 fixed:\n\nWhen the Dag hash is unchanged but the bundle moved to a new commit, `write_dag` currently updates the latest `DagVersion.bundle_version` in place, even if that version already has task instances.\n\n`write_dag` already has a rule for the changed-hash case: update the latest version in place only if it has no task instances, otherwise create a new `DagVersion`. I'd apply the same rule to the unchanged-hash case:\n\n- No task instances on the latest version → refresh `bundle_version` in place (same as today).\n- Task instances exist → create a new `DagVersion` for the new commit.\n\nThis way:\n- #67657 stays fixed, since new tasks still resolve the new commit.\n- Versions that already ran keep their commit, so old runs show the right commit and triggering at that commit works.\n\nTrade-off: #68336 intentionally avoided new versions on commit-only changes. With this approach, a new version is only created for a commit that follows a run of the current version, not on every commit.\n\nDoes this direction sound OK? If so, I'll open a PR with tests covering both cases. @potiuk ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5879911077/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"Juwon-Ogunseye","id":60205286,"node_id":"MDQ6VXNlcjYwMjA1Mjg2","avatar_url":"https://avatars.githubusercontent.com/u/60205286?v=4","gravatar_id":"","url":"https://api.github.com/users/Juwon-Ogunseye","html_url":"https://github.com/Juwon-Ogunseye","followers_url":"https://api.github.com/users/Juwon-Ogunseye/followers","following_url":"https://api.github.com/users/Juwon-Ogunseye/following{/other_user}","gists_url":"https://api.github.com/users/Juwon-Ogunseye/gists{/gist_id}","starred_url":"https://api.github.com/users/Juwon-Ogunseye/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Juwon-Ogunseye/subscriptions","organizations_url":"https://api.github.com/users/Juwon-Ogunseye/orgs","repos_url":"https://api.github.com/users/Juwon-Ogunseye/repos","events_url":"https://api.github.com/users/Juwon-Ogunseye/events{/privacy}","received_events_url":"https://api.github.com/users/Juwon-Ogunseye/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":32033654654,"node_id":"MEE_lADOAgUK288AAAABTvDu_c8AAAAHdVrHfg","url":"https://api.github.com/repos/apache/airflow/issues/events/32033654654","actor":{"login":"potiuk","id":595491,"node_id":"MDQ6VXNlcjU5NTQ5MQ==","avatar_url":"https://avatars.githubusercontent.com/u/595491?v=4","gravatar_id":"","url":"https://api.github.com/users/potiuk","html_url":"https://github.com/potiuk","followers_url":"https://api.github.com/users/potiuk/followers","following_url":"https://api.github.com/users/potiuk/following{/other_user}","gists_url":"https://api.github.com/users/pot