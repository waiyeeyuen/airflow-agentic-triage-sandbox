github.com/users/daesung9511/following{/other_user}","gists_url":"https://api.github.com/users/daesung9511/gists{/gist_id}","starred_url":"https://api.github.com/users/daesung9511/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daesung9511/subscriptions","organizations_url":"https://api.github.com/users/daesung9511/orgs","repos_url":"https://api.github.com/users/daesung9511/repos","events_url":"https://api.github.com/users/daesung9511/events{/privacy}","received_events_url":"https://api.github.com/users/daesung9511/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-30T23:26:32Z","updated_at":"2026-07-30T23:26:32Z","body":"I'd like to work on this issue.\n\nI think `scheduler.persistence` would be cleaner than `workers.local.persistence`. While either could work functionally, the StatefulSet and PVC are part of the scheduler workload, so organizing the setting under `scheduler` seems more consistent with the resource hierarchy.\n\nShould the new setting fall back to `workers.celery.persistence` for backward compatibility, or can we simply remove the existing coupling?\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5137305298/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"daesung9511","id":82129510,"node_id":"MDQ6VXNlcjgyMTI5NTEw","avatar_url":"https://avatars.githubusercontent.com/u/82129510?v=4","gravatar_id":"","url":"https://api.github.com/users/daesung9511","html_url":"https://github.com/daesung9511","followers_url":"https://api.github.com/users/daesung9511/followers","following_url":"https://api.github.com/users/daesung9511/following{/other_user}","gists_url":"https://api.github.com/users/daesung9511/gists{/gist_id}","starred_url":"https://api.github.com/users/daesu