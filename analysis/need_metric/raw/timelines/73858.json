ithub.com/repos/apache/airflow/stargazers","contributors_url":"https://api.github.com/repos/apache/airflow/contributors","subscribers_url":"https://api.github.com/repos/apache/airflow/subscribers","subscription_url":"https://api.github.com/repos/apache/airflow/subscription","commits_url":"https://api.github.com/repos/apache/airflow/commits{/sha}","git_commits_url":"https://api.github.com/repos/apache/airflow/git/commits{/sha}","comments_url":"https://api.github.com/repos/apache/airflow/comments{/number}","issue_comment_url":"https://api.github.com/repos/apache/airflow/issues/comments{/number}","contents_url":"https://api.github.com/repos/apache/airflow/contents/{+path}","compare_url":"https://api.github.com/repos/apache/airflow/compare/{base}...{head}","merges_url":"https://api.github.com/repos/apache/airflow/merges","archive_url":"https://api.github.com/repos/apache/airflow/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/apache/airflow/downloads","issues_url":"https://api.github.com/repos/apache/airflow/issues{/number}","pulls_url":"https://api.github.com/repos/apache/airflow/pulls{/number}","milestones_url":"https://api.github.com/repos/apache/airflow/milestones{/number}","notifications_url":"https://api.github.com/repos/apache/airflow/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/apache/airflow/labels{/name}","releases_url":"https://api.github.com/repos/apache/airflow/releases{/id}","deployments_url":"https://api.github.com/repos/apache/airflow/deployments","created_at":"2015-04-13T18:04:58Z","updated_at":"2026-10-29T14:39:15Z","pushed_at":"2026-10-29T14:43:56Z","git_url":"git://github.com/apache/airflow.git","ssh_url":"git@github.com:apache/airflow.git","clone_url":"https://github.com/apache/airflow.git","svn_url":"https://github.com/apache/airflow","homepage":"https://airflow.apache.org/","size":790917,"stargazers_count":47308,"watchers_count":47308,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":18214,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1927,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["airflow","apache","apache-airflow","automation","dag","data-engineering","data-integration","data-orchestrator","data-pipelines","data-science","elt","etl","machine-learning","mlops","orchestration","python","scheduler","workflow","workflow-engine","workflow-orchestration"],"visibility":"public","forks":18214,"open_issues":1927,"watchers":47308,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/apache/airflow/pulls/73979","html_url":"https://github.com/apache/airflow/pull/73979","diff_url":"https://github.com/apache/airflow/pull/73979.diff","patch_url":"https://github.com/apache/airflow/pull/73979.patch","merged_at":null},"body":"Bundle refreshes were SIGKILLing callback processors for Dags packaged inside zip archives even though the Dag files were still present.\n\nThe scanner reports a zip archive as a single entry (`my_dags.zip`) while callback processors are keyed by the Dag file path inside the archive (`my_dags.zip/my_dag.py`). `terminate_orphan_processes` compared the two directly, so each refresh saw the inner path as missing and killed the processor. The same direct comparison in `purge_removed_files_from_queue` and `remove_orphaned_file_stats` dropped the Dag from the queue and wiped its stats on every refresh too.\n\nThe presence check now treats a path inside a zip as observed while its containing archive is in the scan set (`_file_is_present` in `manager.py`), applied to all three call sites so they stay consistent.\n\nCloses #73858.\n\nTests: four new unit tests in `airflow-core/tests/unit/dag_processing/test_manager.py` covering the kill/no-kill directions for `terminate_orphan_processes`, the queue purge, and the stats cleanup.\n\nNote: I could not run the Airflow test suite in this environment, so CI will need to confirm.\n","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/73979/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/73979/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5917202540","html_url":"https://github.com/apache/airflow/issues/73858#issuecomment-5917202540","issue_url":"https://api.github.com/repos/apache/airflow/issues/73858","id":5917202540,"node_id":"IC_kwDOAgUK288AAAABYLFYbA","user":{"login":"bunnysayzz","id":91439361,"node_id":"MDQ6VXNlcjkxNDM5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/91439361?v=4","gravatar_id":"","url":"https://api.github.com/users/bunnysayzz","html_url":"https://github.com/bunnysayzz","followers_url":"https://api.github.com/users/bunnysayzz/followers","following_url":"https://api.github.com/users/bunnysayzz/following{/other_user}","gists_url":"https://api.github.com/users/bunnysayzz/gists{/gist_id}","starred_url":"https://api.github.com/users/bunnysayzz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bunnysayzz/subscriptions","organizations_url":"https://api.github.com/users/bunnysayzz/orgs","repos_url":"https://api.github.com/users/bunnysayzz/repos","events_url":"https://api.github.com/users/bunnysayzz/events{/privacy}","received_events_url":"https://api.github.com/users/bunnysayzz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T18:24:31Z","updated_at":"2026-09-30T18:24:31Z","body":"PR is up: https://github.com/apache/airflow/pull/73979\n\nThe presence checks (`terminate_orphan_processes`, `purge_removed_files_from_queue`, `remove_orphaned_file_stats`) now treat a path inside a zip as observed while its containing archive is in the scan set, via a shared `_file_is_present` helper in `manager.py`. So the callback processor for `my_dags.zip/my_dag.py` survives the refresh as long as `my_dags.zip` is still scanned, and still gets killed when the archive is actually gone.\n\nAdded four unit tests in `test_manager.py` covering both kill directions plus the queue purge and stats cleanup.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5917202540/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"bunnysayzz","id":91439361,"node_id":"MDQ6VXNlcjkxNDM5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/91439361?v=4","gravatar_id":"","url":"https://api.github.com/users/bunnysayzz","html_url":"https://github.com/bunnysayzz","followers_url":"https://api.github.com/users/bunnysayzz/followers","following_url":"https://api.github.com/users/bunnysayzz/following{/other_user}","gists_url":"https://api.github.com/users/bunnysayzz/gists{/gist_id}","starred_url":"https://api.github.com/users/bunnysayzz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bunnysayzz/subscriptions","organizations_url":"https://api.github.com/users/bunnysayzz/orgs","repos_url":"https://api.github.com/users/bunnysayzz/repos","events_url":"https://api.github.com/users/bunnysayzz/events{/privacy}","received_events_url":"https://api.github.com/users/bunnysayzz/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/is