5Mjk2MzEx","avatar_url":"https://avatars.githubusercontent.com/u/49296311?v=4","gravatar_id":"","url":"https://api.github.com/users/TillerBurr","html_url":"https://github.com/TillerBurr","followers_url":"https://api.github.com/users/TillerBurr/followers","following_url":"https://api.github.com/users/TillerBurr/following{/other_user}","gists_url":"https://api.github.com/users/TillerBurr/gists{/gist_id}","starred_url":"https://api.github.com/users/TillerBurr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TillerBurr/subscriptions","organizations_url":"https://api.github.com/users/TillerBurr/orgs","repos_url":"https://api.github.com/users/TillerBurr/repos","events_url":"https://api.github.com/users/TillerBurr/events{/privacy}","received_events_url":"https://api.github.com/users/TillerBurr/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2026-09-29T14:38:33Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5917149071","html_url":"https://github.com/apache/airflow/issues/73858#issuecomment-5917149071","issue_url":"https://api.github.com/repos/apache/airflow/issues/73858","id":5917149071,"node_id":"IC_kwDOAgUK288AAAABYLCHjw","user":{"login":"bunnysayzz","id":91439361,"node_id":"MDQ6VXNlcjkxNDM5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/91439361?v=4","gravatar_id":"","url":"https://api.github.com/users/bunnysayzz","html_url":"https://github.com/bunnysayzz","followers_url":"https://api.github.com/users/bunnysayzz/followers","following_url":"https://api.github.com/users/bunnysayzz/following{/other_user}","gists_url":"https://api.github.com/users/bunnysayzz/gists{/gist_id}","starred_url":"https://api.github.com/users/bunnysayzz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bunnysayzz/subscriptions","organizations_url":"https://api.github.com/users/bunnysayzz/orgs","repos_url":"https://api.github.com/users/bunnysayzz/repos","events_url":"https://api.github.com/users/bunnysayzz/events{/privacy}","received_events_url":"https://api.github.com/users/bunnysayzz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-30T18:20:58Z","updated_at":"2026-09-30T18:20:58Z","body":"Can reproduce this from the code. `_find_files_in_bundle` yields the zip archive itself (`my_dags.zip`) since the scanner lists zip entries as files, but `_add_callback_to_queue` keys the callback processor by the path inside the archive (`my_dags.zip/my_dag.py`). On the next bundle refresh `terminate_orphan_processes` compares presence keys, the inner path never matches the archive entry, and the processor gets SIGKILLed even though its Dag is still there.\n\nFix is straightforward: the presence check should treat a path inside a zip as observed while its containing archive is in the scan set. Opening a PR with the fix plus unit tests for the kill and no-kill directions.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5917149071/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"bunnysayzz","id":91439361,"node_id":"MDQ6VXNlcjkxNDM5MzYx","avatar_url":"https://avatars.githubusercontent.com/u/91439361?v=4","gravatar_id":"","url":"https://api.github.com/users/bunnysayzz","html_url":"https://github.com/bunnysayzz","followers_url":"https://api.github.com/users/bunnysayzz/followers","following_url":"https://api.github.com/users/bunnysayzz/following{/other_user}","gists_url":"https://api.github.com/users/bunnysayzz/gists{/gist_id}","starred_url":"https://api.github.com/users/bunnysayzz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bunnysayzz/subscriptions","organizations_url":"https: