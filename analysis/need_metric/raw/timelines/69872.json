apache/airflow/issues{/number}","pulls_url":"https://api.github.com/repos/apache/airflow/pulls{/number}","milestones_url":"https://api.github.com/repos/apache/airflow/milestones{/number}","notifications_url":"https://api.github.com/repos/apache/airflow/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/apache/airflow/labels{/name}","releases_url":"https://api.github.com/repos/apache/airflow/releases{/id}","deployments_url":"https://api.github.com/repos/apache/airflow/deployments","created_at":"2015-04-13T18:04:58Z","updated_at":"2026-10-29T14:39:15Z","pushed_at":"2026-10-29T14:39:07Z","git_url":"git://github.com/apache/airflow.git","ssh_url":"git@github.com:apache/airflow.git","clone_url":"https://github.com/apache/airflow.git","svn_url":"https://github.com/apache/airflow","homepage":"https://airflow.apache.org/","size":790917,"stargazers_count":47308,"watchers_count":47308,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":18214,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1927,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["airflow","apache","apache-airflow","automation","dag","data-engineering","data-integration","data-orchestrator","data-pipelines","data-science","elt","etl","machine-learning","mlops","orchestration","python","scheduler","workflow","workflow-engine","workflow-orchestration"],"visibility":"public","forks":18214,"open_issues":1927,"watchers":47308,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/apache/airflow/pulls/74659","html_url":"https://github.com/apache/airflow/pull/74659","diff_url":"https://github.com/apache/airflow/pull/74659.diff","patch_url":"https://github.com/apache/airflow/pull/74659.patch","merged_at":null},"body":"`airflow db clean` can fail when cleaning up a stale Dag with task instances that have never started.\r\n\r\nFor example, manually triggering a paused Dag can leave a queued Dag run and task instances with NULL start dates. If the Dag file is subsequently removed and the Dag becomes eligible for cleanup, the following can happen:\r\n\r\n1. The task instances survive cleanup because their `start_date` is NULL.\r\n2. The Dag is selected for deletion based on its `last_parsed_time`.\r\n3. Deleting the Dag cascades to its `dag_version` rows, including versions still referenced by the surviving task instances.\r\n4. The database rejects the deletion with a foreign-key constraint violation.\r\n\r\nProtecting referenced versions during `dag_version` cleanup alone is insufficient because deleting the parent Dag can still cascade to those versions.\r\n\r\nThis change reuses the existing `skip_if_referenced` mechanism with `task_instance.dag_id` to exclude Dags that still have task instances. The reference check applies both when selecting cleanup candidates and immediately before deletion. Dags without surviving task instances remain eligible for cleanup.\r\n\r\nRegression tests verify that:\r\n\r\n- Referenced Dags, pinned versions, and never-started task instances are preserved, while unreferenced Dags and their versions are deleted.\r\n- Cleanup works with and without archiving, and with and without an explicit batch size.\r\n- A task instance added between candidate selection and deletion prevents its Dag from being deleted.\r\n\r\nAll five new test cases fail with a foreign-key constraint violation without the fix.\r\n\r\nThis PR addresses the cleanup failure in #71864. Deleting records with NULL start dates is a separate change tracked in #69872 and discussed in #69879.\r\n\r\ncloses: #71864\r\n\r\n### Validation\r\n\r\n- `test_db_cleanup.py`: PostgreSQL 120 passed, MySQL 119 passed, SQLite 118 passed, with backend-specific skips.\r\n- Selective DB suites: API, Other, Core, CLI, Serialization, and Always passed on SQLite.\r\n- Selective non-DB suite: 4,988 passed.\r\n- Regular and manual static checks passed.\r\n- `apache-airflow` documentation build passed.\r\n\r\n---\r\n\r\n##### Was generative AI tooling used to co-author this PR?\r\n\r\n- [X] Yes — Codex (GPT-6)\r\n\r\nGenerated-by: Codex (GPT-6) following [the guidelines](https://github.com/apache/airflow/blob/main/contributing-docs/05_pull_requests.rst#gen-ai-assisted-contributions)","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/74659/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/74659/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"}]]
