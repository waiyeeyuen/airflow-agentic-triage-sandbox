_events","type":"User","user_view_type":"public","site_admin":false},"intent":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5153704608","html_url":"https://github.com/apache/airflow/issues/70880#issuecomment-5153704608","issue_url":"https://api.github.com/repos/apache/airflow/issues/70880","id":5153704608,"node_id":"IC_kwDOAgUK288AAAABMy9KoA","user":{"login":"dshemetov","id":1810426,"node_id":"MDQ6VXNlcjE4MTA0MjY=","avatar_url":"https://avatars.githubusercontent.com/u/1810426?v=4","gravatar_id":"","url":"https://api.github.com/users/dshemetov","html_url":"https://github.com/dshemetov","followers_url":"https://api.github.com/users/dshemetov/followers","following_url":"https://api.github.com/users/dshemetov/following{/other_user}","gists_url":"https://api.github.com/users/dshemetov/gists{/gist_id}","starred_url":"https://api.github.com/users/dshemetov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dshemetov/subscriptions","organizations_url":"https://api.github.com/users/dshemetov/orgs","repos_url":"https://api.github.com/users/dshemetov/repos","events_url":"https://api.github.com/users/dshemetov/events{/privacy}","received_events_url":"https://api.github.com/users/dshemetov/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-01T22:17:54Z","updated_at":"2026-08-04T20:24:53Z","body":"> Is the behavior that you mentioned expected?\n\nIt certainly seems like FIFO behavior is expected for non Asset-triggered dagruns (there are explicit unit tests checking that), so I'm extrapolating that we'd want Asset-triggered dagruns to be consistent with that.\n\n> Tasks in a DAG are still executing in the proper order, but you're saying that Tasks across multiple DAG runs are not?\n\nSort of. The analog isn't exact, but if we were to, say, let those emitted Assets all pile up in a single consumer run, .expand() over those on the same `max_active_tis_per_dag=1` task, then the scheduler would use `task_instance.map_index` to order them, so assuming the Assets arrive to the consumer in emission order (I don't know if that's guaranteed) they will then run in that order.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5153704608/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"dshemetov","id":1810426,"node_id":"MDQ6VXNlcjE4MTA0MjY=","avatar_url":"https://avatars.githubusercontent.com/u/1810426?v=4","gravatar_id":"","url":"https://api.github.com/users/dshemetov","html_url":"https://github.com/dshemetov","followers_url":"https://api.github.com/users/dshemetov/followers","following_url":"https://api.github.com/users/dshemetov/following{/other_user}","gists_url":"https://api.github.com/users/dshemetov/gists{/gist_id}","starred_url":"https://api.github.com/users/dshemetov/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dshemetov/subscriptions","organizations_url":"https://api.github.com/users/dshemetov/orgs","repos_url":"https://api.github.com/users/dshemetov/repos","events_url":"https://api.github.com/users/dshemetov/events{/privacy}","received_events_url":"https://api.github.com/users/dshemetov/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":31505559145,"node_id":"REFE_lADOAgUK288AAAABLA1zY88AAAAHVeCuaQ","url":"https://api.github.com/repos/apache/airflow/issues/events/31505559145","actor":{"login":"dshemetov","id":1810426,"node_id":"MDQ6VXNlcjE4MTA0MjY=","avatar_url":"https://avatars.githubusercontent.com/u/1810426?v=4","gravatar_id":"","url":"https://api.github.com/users/dshemetov","html_url":"https://github.com/dshemetov","followers_url":"https://api.github.com/users/dshemetov/followers","following_url":"https://api.github.com/users/dshemetov/fo