ub.com/users/kartik00052/repos","events_url":"https://api.github.com/users/kartik00052/events{/privacy}","received_events_url":"https://api.github.com/users/kartik00052/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5773388164","html_url":"https://github.com/apache/airflow/issues/73525#issuecomment-5773388164","issue_url":"https://api.github.com/repos/apache/airflow/issues/73525","id":5773388164,"node_id":"IC_kwDOAgUK288AAAABWB7phA","user":{"login":"schizophrenicmaniac","id":181649645,"node_id":"U_kgDOCtPA7Q","avatar_url":"https://avatars.githubusercontent.com/u/181649645?v=4","gravatar_id":"","url":"https://api.github.com/users/schizophrenicmaniac","html_url":"https://github.com/schizophrenicmaniac","followers_url":"https://api.github.com/users/schizophrenicmaniac/followers","following_url":"https://api.github.com/users/schizophrenicmaniac/following{/other_user}","gists_url":"https://api.github.com/users/schizophrenicmaniac/gists{/gist_id}","starred_url":"https://api.github.com/users/schizophrenicmaniac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schizophrenicmaniac/subscriptions","organizations_url":"https://api.github.com/users/schizophrenicmaniac/orgs","repos_url":"https://api.github.com/users/schizophrenicmaniac/repos","events_url":"https://api.github.com/users/schizophrenicmaniac/events{/privacy}","received_events_url":"https://api.github.com/users/schizophrenicmaniac/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T08:23:53Z","updated_at":"2026-09-22T08:23:53Z","body":"I'd like to work on this. My approach: find all Path.read_text()/open() calls without explicit encoding in pytest_plugin.py and update_providers_dependencies.py, add encoding=\"utf-8\" to them (and matching write calls), then verify collection succeeds on Windows without needing PYTHONUTF8=1. Will submit a PR once validated.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5773388164/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"schizophrenicmaniac","id":181649645,"node_id":"U_kgDOCtPA7Q","avatar_url":"https://avatars.githubusercontent.com/u/181649645?v=4","gravatar_id":"","url":"https://api.github.com/users/schizophrenicmaniac","html_url":"https://github.com/schizophrenicmaniac","followers_url":"https://api.github.com/users/schizophrenicmaniac/followers","following_url":"https://api.github.com/users/schizophrenicmaniac/following{/other_user}","gists_url":"https://api.github.com/users/schizophrenicmaniac/gists{/gist_id}","starred_url":"https://api.github.com/users/schizophrenicmaniac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schizophrenicmaniac/subscriptions","organizations_url":"https://api.github.com/users/schizophrenicmaniac/orgs","repos_url":"https://api.github.com/users/schizophrenicmaniac/repos","events_url":"https://api.github.com/users/schizophrenicmaniac/events{/privacy}","received_events_url":"https://api.github.com/users/schizophrenicmaniac/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5773511536","html_url":"https://github.com/apache/airflow/issues/73525#issuecomment-5773511536","issue_url":"https://api.github.com/repos/apache/airflow/issues/73525","id":5773511536,"node_id":"IC_kwDOAgUK288AAAABWCDLcA","user":{"login":"kartik00052","id":198893820,"node_id":"U_kgDOC9rg_A","avatar_url":"https://avatars.githubusercontent.com/u/198893820?v=4","gravatar_id":"","url":"https://api.github.com/users/kartik00052","html_url":"https://github.com/kartik00052","followers_url":"https://api.github.com/users/kartik00052/followers","following_url":"https://api.github.com/users/kartik00052/following{/other_user}","gists_url":"https://api.github.com/users/kartik00052/gists{/gist_id}","starred_url":"https://api.github.com/users/kartik00052/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kartik00052/subscriptions","organizations_url":"https://api.github.com/users/kartik00052/orgs","repos_url":"https://api.github.com/users/kartik00052/repos","events_url":"https://api.github.com/users/kartik00052/events{/privacy}","received_events_url":"https://api.github.com/users/kartik00052/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-22T08:34:11Z","updated_at":"2026-09-22T08:34:11Z","body":"I can confirm and narrow this down exactly — grepped both files for `.read_text()` / `.write_text()` / `open()` calls without an explicit encoding:\n\n**`devel-common/src/tests_common/pytest_plugin.py`**\n- L169: `AIRFLOW_PYPROJECT_TOML_FILE_PATH.read_text().splitlines()`\n- L201: `PROVIDER_DEPENDENCIES_JSON_HASH_PATH.read_text().strip()`\n- L203: `PROVIDER_DEPENDENCIES_JSON_HASH_PATH.write_text(calculated_provider_deps_hash)`\n\n**`scripts/ci/prek/update_providers_dependencies.py`**\n- L73: `pyproject_toml_file_path.read_text()` (fed into `tomllib.loads`)\n- L98: `provider_yaml_file.read_text()` (fed into `yaml.safe_load`)\n- L230, L233: `DEPENDENCIES_JSON_FILE_PATH.read_text()`\n- L235: `DEPENDENCIES_JSON_FILE_PATH.write_text(new_content)`\n\nThat's 8 call sites total, no bare `open()` calls in either file — so the fix is contained to adding `encoding=\"utf-8\"` to these 8 `read_text`/`write_text` calls, nothing broader in scope.\n\nPlanning to validate by reproducing with `set PYTHONUTF8=0` per the repro steps above, confirming collection fails first, then confirming it passes after the change — and separately confirming behavior is unchanged on Linux/macOS (these are already UTF-8 by default there, so this should be a no-op change on non-Windows). Will submit a PR once that's verified.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5773511536/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kartik00052","id":198893820,"node_id":"U_kgDOC9rg_A","avatar_url":"https://avatars.githubusercontent.com/u/198893820?v=4","gravatar_id":"","url":"https://api.github.com/users/kartik00052","html_url":"https://github.com/kartik00052","followers_url":"https://api.github.com/users/kartik00052/followers","following_url":"https://api.github.com/users/kartik00052/following{/other_user}","gists_url":"https://api.github.com/users/kartik00052/gists{/gist_id}","starred_url":"https://api.github.com/users/kartik00052/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kartik00052/subscriptions","organizations_url":"https://api.github.com/users/kartik00052/orgs","repos_url":"https://api.github.com/users/kartik00052/repos","events_url":"https://api.github.com/users/kartik00052/events{/privacy}","received_events_url":"https://api.github.com/users/kartik00052/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"schizophrenicmaniac","id":181649645,"node_id":"U_kgDOCtPA7Q","avatar_url":"https://avatars.githubusercontent.com/u/181649645?v=4","gravatar_id":"","url":"https://api.github.com/users/schizophrenicmaniac","html_url":"https://github.com/schizophrenicmaniac","followers_url":"https://api.github.com/users/schizophrenicmaniac/followers","following_url":"https://api.github.com/users/schizophrenicmaniac/following{/other_user}","gists_url":"https://api.github.com/users/schizophrenicmaniac/gists{/gist_id}","starred_url":"https://api.github.com/users/schizophrenicmaniac/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schizophreni