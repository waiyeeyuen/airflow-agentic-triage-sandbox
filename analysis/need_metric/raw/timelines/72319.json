2, DATA: 2700}) == timedelta(minutes=45)\n```\n","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/72326/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/72326/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"actor":{"login":"CaptainAni187","id":61719828,"node_id":"MDQ6VXNlcjYxNzE5ODI4","avatar_url":"https://avatars.githubusercontent.com/u/61719828?v=4","gravatar_id":"","url":"https://api.github.com/users/CaptainAni187","html_url":"https://github.com/CaptainAni187","followers_url":"https://api.github.com/users/CaptainAni187/followers","following_url":"https://api.github.com/users/CaptainAni187/following{/other_user}","gists_url":"https://api.github.com/users/CaptainAni187/gists{/gist_id}","starred_url":"https://api.github.com/users/CaptainAni187/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CaptainAni187/subscriptions","organizations_url":"https://api.github.com/users/CaptainAni187/orgs","repos_url":"https://api.github.com/users/CaptainAni187/repos","events_url":"https://api.github.com/users/CaptainAni187/events{/privacy}","received_events_url":"https://api.github.com/users/CaptainAni187/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-08T13:41:57Z","updated_at":"2026-09-08T13:41:57Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/apache/airflow/issues/72710","repository_url":"https://api.github.com/repos/apache/airflow","labels_url":"https://api.github.com/repos/apache/airflow/issues/72710/labels{/name}","comments_url":"https://api.github.com/repos/apache/airflow/issues/72710/comments","events_url":"https://api.github.com/repos/apache/airflow/issues/72710/events","html_url":"https://github.com/apache/airflow/pull/72710","id":5387482010,"node_id":"PR_kwDOAgUK288AAAABCrkIGw","numbe