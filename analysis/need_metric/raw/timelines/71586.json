d_events_url":"https://api.github.com/users/jroachgolf84/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"id":30457712789,"node_id":"REFE_lADOAgUK288AAAABMuEMkM8AAAAHF2vQlQ","url":"https://api.github.com/repos/apache/airflow/issues/events/30457712789","actor":{"login":"ShivanshhhG","id":228652350,"node_id":"U_kgDODaD1Pg","avatar_url":"https://avatars.githubusercontent.com/u/228652350?v=4","gravatar_id":"","url":"https://api.github.com/users/ShivanshhhG","html_url":"https://github.com/ShivanshhhG","followers_url":"https://api.github.com/users/ShivanshhhG/followers","following_url":"https://api.github.com/users/ShivanshhhG/following{/other_user}","gists_url":"https://api.github.com/users/ShivanshhhG/gists{/gist_id}","starred_url":"https://api.github.com/users/ShivanshhhG/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ShivanshhhG/subscriptions","organizations_url":"https://api.github.com/users/ShivanshhhG/orgs","repos_url":"https://api.github.com/users/ShivanshhhG/repos","events_url":"https://api.github.com/users/ShivanshhhG/events{/privacy}","received_events_url":"https://api.github.com/users/ShivanshhhG/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"2ddc059724a9d3b50133dca7c0955e569c8041ae","commit_url":"https://api.github.com/repos/ShivanshhhG/airflow/commits/2ddc059724a9d3b50133dca7c0955e569c8041ae","created_at":"2026-09-03T02:07:49Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5677551003","html_url":"https://github.com/apache/airflow/issues/71586#issuecomment-5677551003","issue_url":"https://api.github.com/repos/apache/airflow/issues/71586","id":5677551003,"node_id":"IC_kwDOAgUK288AAAABUmiNmw","user":{"login":"dondaum","id":18313436,"node_id":"MDQ6VXNlcjE4MzEzNDM2","avatar_url":"https://avatars.githubusercontent.com/u/18313436?v=4","gravatar_id":"","url":"https://api.github.com/users/dondaum","html_url":"https://github.com/dondaum","followers_url":"https://api.github.com/users/dondaum/followers","following_url":"https://api.github.com/users/dondaum/following{/other_user}","gists_url":"https://api.github.com/users/dondaum/gists{/gist_id}","starred_url":"https://api.github.com/users/dondaum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dondaum/subscriptions","organizations_url":"https://api.github.com/users/dondaum/orgs","repos_url":"https://api.github.com/users/dondaum/repos","events_url":"https://api.github.com/users/dondaum/events{/privacy}","received_events_url":"https://api.github.com/users/dondaum/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-15T09:02:06Z","updated_at":"2026-09-15T09:02:06Z","body":"I assume this only occurs when the option to render fields as native Python objects is enabled, i.e. `render_template_as_native_obj=True` is set: \nhttps://airflow.apache.org/docs/apache-airflow/stable/core-concepts/operators.html#rendering-fields-as-native-python-objects\n\nIn this case, Jinja always attempts to render the value as a native object—in this instance, as an integer. If this option is not enabled, the issue does not arise. There is a relevant section on this in the Airflow documentation.\n\n_NativeEnvironment renders values according to Python literal rules. This is useful when a template should produce a list, dict, number, or boolean, but it also means a string that looks like a number, such as \"42\", can be rendered as the integer 42. Keep the default string rendering, use a callable template field, or add explicit quoting if the task needs the value to stay a string._\n\nUsing `map_index_template=\"'{{ ... }}'\"` instead of `map_index_template=\"{{ ... }}\"` should resolve the issue.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5677551003/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"dondaum","id":18313436,"node_id":"MDQ6VXNlcjE4MzEzNDM2","avatar_url":"https://avatars.githubusercontent.com/u/18313436?v=4","gravatar_id":"","url":"https://api.github.com/users/dondaum","html_url":"https://github.com/dondaum","followers_url":"https://api.github.com/users/dondaum/followers","following_url":"https://api.github.com/users/dondaum/following{/other_user}","gists_url":"https://api.github.com/users/dondaum/gists{/gist_id}","starred_url":"https://api.github.com/users/dondaum/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dondaum/subscriptions","organizations_url":"https://api.github.com/users/dondaum/orgs","repos_url":"https://api.github.com/users/dondaum/repos","events_url":"https://api.github.com/users/dondaum/events{/privacy}","received_events_url":"https://api.github.com/users/dondaum/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/6078848464","html_url":"https://github.com/apache/airflow/issues/71586#issuecomment-6078848464","issue_url":"https://api.github.com/repos/apache/airflow/issues/71586","id":6078848464,"node_id":"IC_kwDOAgUK288AAAABalPd0A","user":{"login":"ngnnah","id":58123635,"node_id":"MDQ6VXNlcjU4MTIzNjM1","avatar_url":"https://avatars.githubusercontent.com/u/58123635?v=4","gravatar_id":"","url":"https://api.github.com/users/ngnnah","html_url":"https://github.com/ngnnah","followers_url":"https://api.github.com/users/ngnnah/followers","following_url":"https://api.github.com/users/ngnnah/following{/other_user}","gists_url":"https://api.github.com/users/ngnnah/gists{/gist_id}","starred_url":"https://api.github.com/users/ngnnah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngnnah/subscriptions","organizations_url":"https://api.github.com/users/ngnnah/orgs","repos_url":"https://api.github.com/users/ngnnah/repos","events_url":"https://api.github.com/users/ngnnah/events{/privacy}","received_events_url":"https://api.github.com/users/ngnnah/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-09T10:12:11Z","updated_at":"2026-10-09T10:12:11Z","body":"Hit this on 3.3.2 (task-sdk 1.3.1). We set `render_template_as_native_obj=True` for every DAG through a shared factory, and a mapped task labelled `map_index_template=\"{{ task.file_id }}\"` (an int id) failed all 85 instances on its first production run.\n\nRe whether it's a bug: quoting the template works, but a map index label can only ever be a string. `_render_map_index` is typed `-> str | None`, and `SetRenderedMapIndex.rendered_map_index` is `str`; with the `len()` removed, an int still fails there (`Input should be a valid string`). Native rendering can't produce a valid non-string label, so for this one template it only adds a failure mode.\n\nIt also fails late. The pre-execute render swallows the error and the post-execute render raises it, so the task's work completes and then the task is marked failed and retried.\n\n+1 for the `str()` in #71592.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/6078848464/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"ngnnah","id":58123635,"node_id":"MDQ6VXNlcjU4MTIzNjM1","avatar_url":"https://avatars.githubusercontent.com/u/58123635?v=4","gravatar_id":"","url":"https://api.github.com/users/ngnnah","html_url":"https://github.com/ngnnah","followers_url":"https://api.github.com/users/ngnnah/followers","following_url":"https://api.github.com/users/ngnnah/following{/other_user}","gists_url":"https://api.github.com/users/ngnnah/gists{/gist_id}","starred_url":"https://api.github.com/users/ngnnah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ngnnah/subscriptions","organizations_url":"https://api.github.com/users/ngnnah/orgs","repos_url":"https://api.github.com/users/ngnnah/repos","events_url":"https://api.github.com/users/ngnnah/events{/privacy}","received_events_url":"https://api.github.com/users/ngnnah/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":33165820354,"node_id":"CE_lADOAgUK288AAAABMuEMkM8AAAAHuNZBwg","url":"https://api.github.com/repos/apache/airflow/issues/events/33165820354","actor":{"login":"kaxil","id":8811558,"node_id":"MDQ6VXNlcjg4MTE1NTg=","avatar_url":"https://avatars.githubusercontent.com/u/8811558?v=4","gravatar_id":"","url":"https://api.github.com/users/kaxil","html_url":"https://github.com/kaxil","followers_url":"https://api.github.com/users/kaxil/followers","following_url":"https://api.github.com/users/kaxil/following{/other_user}","gists_url":"https://api.github.com/users/kaxil/gists{/gist_id}","starred_url":"https://api.github.com/users/kaxil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kaxil/subscriptions","organizations_url":"https://api.github.com/users/kaxil/orgs","repos_url":"https://api.github.com/users/kaxil/repos","events_url":"https://api.github.com/users/kaxil/events{/privacy}","received_events_url":"https://api.github.com/users/kaxil/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"closed","commit_id":null,"commit_url":null,"created_at":"2026-10-13T19:35:48Z","state_reason":null,"intent":null,"performed_via_github_app":null}]]
