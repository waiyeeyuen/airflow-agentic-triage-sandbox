le preserving the behavior added for #64884, with coverage ensuring unrelated sibling DAGs are not rewritten. If that direction looks right, could you assign this issue to me?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5539981741/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"jasperjonkhans","id":196701879,"node_id":"U_kgDOC7lutw","avatar_url":"https://avatars.githubusercontent.com/u/196701879?v=4","gravatar_id":"","url":"https://api.github.com/users/jasperjonkhans","html_url":"https://github.com/jasperjonkhans","followers_url":"https://api.github.com/users/jasperjonkhans/followers","following_url":"https://api.github.com/users/jasperjonkhans/following{/other_user}","gists_url":"https://api.github.com/users/jasperjonkhans/gists{/gist_id}","starred_url":"https://api.github.com/users/jasperjonkhans/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jasperjonkhans/subscriptions","organizations_url":"https://api.github.com/users/jasperjonkhans/orgs","repos_url":"https://api.github.com/users/jasperjonkhans/repos","events_url":"https://api.github.com/users/jasperjonkhans/events{/privacy}","received_events_url":"https://api.github.com/users/jasperjonkhans/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5626393052","html_url":"https://github.com/apache/airflow/issues/72513#issuecomment-5626393052","issue_url":"https://api.github.com/repos/apache/airflow/issues/72513","id":5626393052,"node_id":"IC_kwDOAgUK288AAAABT1vx3A","user":{"login":"bingqin2","id":126308766,"node_id":"U_kgDOB4dRng","avatar_url":"https://avatars.githubusercontent.com/u/126308766?v=4","gravatar_id":"","url":"https://api.github.com/users/bingqin2","html_url":"ht