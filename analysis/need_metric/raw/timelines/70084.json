12`\r\n- `uv` fell back to `apache-airflow-providers-snowflake=6.4.0`\r\n\r\nThis PR handles this issue by adding a cap for `cloudpickle`.\r\n\r\ncloses: #70020 \r\nrelated: #70084","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/70086/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/70086/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":28171237035,"node_id":"LE_lADOAgUK288AAAABJU--cc8AAAAGjyL2qw","url":"https://api.github.com/repos/apache/airflow/issues/events/28171237035","actor":{"login":"jroachgolf84","id":116606359,"node_id":"U_kgDOBvNFlw","avatar_url":"https://avatars.githubusercontent.com/u/116606359?v=4","gravatar_id":"","url":"https://api.github.com/users/jroachgolf84","html_url":"https://github.com/jroachgolf84","followers_url":"https://api.github.com/users/jroachgolf84/followers","following_url":"https://api.github.com/users/jroachgolf84/following{/other_user}","gists_url":"https://api.github.com/users/jroachgolf84/gists{/gist_id}","starred_url":"https://api.github.com/users/jroachgolf84/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jroachgolf84/subscriptions","organizations_url":"https://api.github.com/users/jroachgolf84/orgs","repos_url":"https://api.github.com/users/jroachgolf84/repos","events_url":"https://api.github.com/users/jroachgolf84/events{/privacy}","received_events_url":"https://api.github.com/users/jroachgolf84/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"labeled","commit_id":null,"commit_url":null,"created_at":"2026-07-19T02:45:23Z","label":{"name":"needs-triage","color":"b60205"},"intent":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5013872888","html_url":"https://github.com/apache/airflow/issues/70084#issuecomment-501