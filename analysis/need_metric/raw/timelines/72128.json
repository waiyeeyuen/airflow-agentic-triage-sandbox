:"https://avatars.githubusercontent.com/u/35884252?v=4","gravatar_id":"","url":"https://api.github.com/users/amoghrajesh","html_url":"https://github.com/amoghrajesh","followers_url":"https://api.github.com/users/amoghrajesh/followers","following_url":"https://api.github.com/users/amoghrajesh/following{/other_user}","gists_url":"https://api.github.com/users/amoghrajesh/gists{/gist_id}","starred_url":"https://api.github.com/users/amoghrajesh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/amoghrajesh/subscriptions","organizations_url":"https://api.github.com/users/amoghrajesh/orgs","repos_url":"https://api.github.com/users/amoghrajesh/repos","events_url":"https://api.github.com/users/amoghrajesh/events{/privacy}","received_events_url":"https://api.github.com/users/amoghrajesh/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":1937475224,"node_id":"MDU6TGFiZWwxOTM3NDc1MjI0","url":"https://api.github.com/repos/apache/airflow/labels/area:API","name":"area:API","color":"efe07c","default":false,"description":"Airflow's REST/HTTP API","archived_at":null,"archived_by":null},{"id":1993586993,"node_id":"MDU6TGFiZWwxOTkzNTg2OTkz","url":"https://api.github.com/repos/apache/airflow/labels/kind:documentation","name":"kind:documentation","color":"1ED98E","default":false,"description":"","archived_at":null,"archived_by":null},{"id":2172803017,"node_id":"MDU6TGFiZWwyMTcyODAzMDE3","url":"https://api.github.com/repos/apache/airflow/labels/type:bug-fix","name":"type:bug-fix","color":"5AF3AB","default":false,"description":"Changelog: Bug Fixes","archived_at":null,"archived_by":null},{"id":2514952451,"node_id":"MDU6TGFiZWwyNTE0OTUyNDUx","url":"https://api.github.com/repos/apache/airflow/labels/area:UI","name":"area:UI","color":"1d76db","default":false,"description":"Related to UI/UX. For Frontend Developers.","archived_at":null,"archived_by":null},{"id":8391444640,"node_id":"LA_kwDOAgUK288AAAAB9CtIoA","url":"https://api.g