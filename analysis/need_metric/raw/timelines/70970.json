url":"https://api.github.com/repos/apache/airflow/issues{/number}","pulls_url":"https://api.github.com/repos/apache/airflow/pulls{/number}","milestones_url":"https://api.github.com/repos/apache/airflow/milestones{/number}","notifications_url":"https://api.github.com/repos/apache/airflow/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/apache/airflow/labels{/name}","releases_url":"https://api.github.com/repos/apache/airflow/releases{/id}","deployments_url":"https://api.github.com/repos/apache/airflow/deployments","created_at":"2015-04-13T18:04:58Z","updated_at":"2026-10-29T14:39:15Z","pushed_at":"2026-10-29T14:39:07Z","git_url":"git://github.com/apache/airflow.git","ssh_url":"git@github.com:apache/airflow.git","clone_url":"https://github.com/apache/airflow.git","svn_url":"https://github.com/apache/airflow","homepage":"https://airflow.apache.org/","size":790917,"stargazers_count":47308,"watchers_count":47308,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":18214,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1927,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["airflow","apache","apache-airflow","automation","dag","data-engineering","data-integration","data-orchestrator","data-pipelines","data-science","elt","etl","machine-learning","mlops","orchestration","python","scheduler","workflow","workflow-engine","workflow-orchestration"],"visibility":"public","forks":18214,"open_issues":1927,"watchers":47308,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/apache/airflow/pulls/70972","html_url":"https://github.com/apache/airflow/pull/70972","diff_url":"https://github.com/apache/airflow/pull/70972.diff","patch_url":"https://github.com/apache/airflow/pull/70972.patch","merged_at":"2026-08-05T01:13:55Z"},"body":"More details in #70970.\r\n\r\nAsset-triggered scheduling had the scheduler reconstruct which AssetEvents fed a run from a created_at time window. The prior fix #62501 committed each AssetEvent in separate short-lived sessions so it was visible early, but that broke atomicity.\r\n\r\nThis commit changes the ADRQ to directly reference the asset event that generates it, instead of using an implicit asset_id + timestamp combination. Atomicity is restored since we no longer needs to commit separately to get the timestamps right, while still being able to reference the correct asset events from the ADRQ.","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/70972/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/70972/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5333623334","html_url":"https://github.com/apache/airflow/issues/70970#issuecomment-5333623334","issue_url":"https://api.github.com/repos/apache/airflow/issues/70970","id":5333623334,"node_id":"IC_kwDOAgUK288AAAABPeiiJg","user":{"login":"HarnageaGabriel","id":174127384,"node_id":"U_kgDOCmD5GA","avatar_url":"https://avatars.githubusercontent.com/u/174127384?v=4","gravatar_id":"","url":"https://api.github.com/users/HarnageaGabriel","html_url":"https://github.com/HarnageaGabriel","followers_url":"https://api.github.com/users/HarnageaGabriel/followers","following_url":"https://api.github.com/users/HarnageaGabriel/following{/other_user}","gists_url":"https://api.github.com/users/HarnageaGabriel/gists{/gist_id}","starred_url":"https://api.github.com/users/HarnageaGabriel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HarnageaGabriel/subscriptions","organizations_url":"https://api.github.com/users/HarnageaGabriel/orgs","repos_url":"https://api.github.com/users/HarnageaGabriel/repos","events_url":"https://api.github.com/users/HarnageaGabriel/events{/privacy}","received_events_url":"https://api.github.com/users/HarnageaGabriel/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-18T20:23:09Z","updated_at":"2026-08-18T20:23:09Z","body":"Hi @uranusjr, I see this is assigned to you. I'd be happy to take this on if you haven't started work on it yet — the proposed fix (drop the side session in `_create_asset_event`, single atomic commit, and add an FK from `AssetDagRunQueue` to the `AssetEvent` instead of relying on timestamp matching) makes sense to me after reading through #62501's diff.\n\nCould you let me know whether this is open for a community contribution, or if you're already working on it yourself? If it's open, feel free to unassign/reassign and I'll get started; if you're already on it, I'll leave it to you.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5333623334/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"HarnageaGabriel","id":174127384,"node_id":"U_kgDOCmD5GA","avatar_url":"https://avatars.githubusercontent.com/u/174127384?v=4","gravatar_id":"","url":"https://api.github.com/users/HarnageaGabriel","html_url":"https://github.com/HarnageaGabriel","followers_url":"https://api.github.com/users/HarnageaGabriel/followers","following_url":"https://api.github.com/users/HarnageaGabriel/following{/other_user}","gists_url":"https://api.github.com/users/HarnageaGabriel/gists{