ts{/gist_id}","starred_url":"https://api.github.com/users/pierrejeambrun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pierrejeambrun/subscriptions","organizations_url":"https://api.github.com/users/pierrejeambrun/orgs","repos_url":"https://api.github.com/users/pierrejeambrun/repos","events_url":"https://api.github.com/users/pierrejeambrun/events{/privacy}","received_events_url":"https://api.github.com/users/pierrejeambrun/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"unlabeled","commit_id":null,"commit_url":null,"created_at":"2026-08-27T15:02:23Z","label":{"name":"needs-triage","color":"b60205"},"intent":null,"performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5441051461","html_url":"https://github.com/apache/airflow/issues/71499#issuecomment-5441051461","issue_url":"https://api.github.com/repos/apache/airflow/issues/71499","id":5441051461,"node_id":"IC_kwDOAgUK288AAAABRE_bRQ","user":{"login":"pierrejeambrun","id":14861206,"node_id":"MDQ6VXNlcjE0ODYxMjA2","avatar_url":"https://avatars.githubusercontent.com/u/14861206?v=4","gravatar_id":"","url":"https://api.github.com/users/pierrejeambrun","html_url":"https://github.com/pierrejeambrun","followers_url":"https://api.github.com/users/pierrejeambrun/followers","following_url":"https://api.github.com/users/pierrejeambrun/following{/other_user}","gists_url":"https://api.github.com/users/pierrejeambrun/gists{/gist_id}","starred_url":"https://api.github.com/users/pierrejeambrun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pierrejeambrun/subscriptions","organizations_url":"https://api.github.com/users/pierrejeambrun/orgs","repos_url":"https://api.github.com/users/pierrejeambrun/repos","events_url":"https://api.github.com/users/pierrejeambrun/events{/privacy}","received_events_url":"https://api.github.com/users/pierrejeambrun/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-27T15:03:11Z","updated_at":"2026-08-27T15:12:58Z","body":"Are you using the keycloak auth manager ? The problem I believe is coming from the auth manager umplementation and upstream not having a batch authorize endpoint. Therefore each dag to authorize generate 1 request, all that in a threadpool.\n\nBecause of how dag permissions are modeled, we can't leverage the batch authorize endpoints for dags. We would need some rewrite / migrations to be able to fix that.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5441051461/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"pierrejeambrun","id":14861206,"node_id":"MDQ6VXNlcjE0ODYxMjA2","avatar_url":"https://avatars.githubusercontent.com/u/14861206?v=4","gravatar_id":"","url":"https://api.github.com/users/pierrejeambrun","html_url":"https://github.com/pierrejeambrun","followers_url":"https://api.github.com/users/pierrejeambrun/followers","following_url":"https://api.github.com/users/pierrejeambrun/following{/other_user}","gists_url":"https://api.github.com/users/pierrejeambrun/gists{/gist_id}","starred_url":"https://api.github.com/users/pierrejeambrun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pierrejeambrun/subscriptions","organizations_url":"https://api.github.com/users/pierrejeambrun/orgs","repos_url":"https://api.github.com/users/pierrejeambrun/repos","events_url":"https://api.github.com/users/pierrejeambrun/events{/privacy}","received_events_url":"https://api.github.com/users/pierrejeambrun/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5441761427","html_url":"https://github.com/apache/airflow/issues/71499#issuecomment-5441761427","issue_url":"https://api.github.com/repos/apache/airflow/issues/71499","id":5441761427,"node_id":"IC_kwDOAgUK288AAAABRFqwkw","user":{"login":"stephen-bracken","id":18257727,"node_id":"MDQ6VXNlcjE4MjU3NzI3","avatar_url":"https://avatars.githubusercontent.com/u/18257727?v=4","gravatar_id":"","url":"https://api.github.com/users/stephen-bracken","html_url":"https://github.com/stephen-bracken","followers_url":"https://api.github.com/users/stephen-bracken/followers","following_url":"https://api.github.com/users/stephen-bracken/following{/other_user}","gists_url":"https://api.github.com/users/stephen-bracken/gists{/gist_id}","starred_url":"https://api.github.com/users/stephen-bracken/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stephen-bracken/subscriptions","organizations_url":"https://api.github.com/users/stephen-bracken/orgs","repos_url":"https://api.github.com/users/stephen-bracken/repos","events_url":"https://api.github.com/users/stephen-bracken/events{/privacy}","received_events_url":"https://api.github.com/users/stephen-bracken/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-27T15:58:29Z","updated_at":"2026-08-27T15:58:29Z","body":"> Are you using the keycloak auth manager\n\n@pierrejeambrun Yes we are, this is the problem I am trying to workaround. It would definitely be worth remodeling the batch authorize for Keycloak, as this is a major source of frustration for users. We have a multi team instance with ~900 dags spread across 10 teams,  and the load time for the `/dags` page is in the worst case 20 seconds plus because of this auth flow.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5441761427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"stephen-bracken","id":