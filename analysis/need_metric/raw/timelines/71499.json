thub.com/users/pierrejeambrun/following{/other_user}","gists_url":"https://api.github.com/users/pierrejeambrun/gists{/gist_id}","starred_url":"https://api.github.com/users/pierrejeambrun/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/pierrejeambrun/subscriptions","organizations_url":"https://api.github.com/users/pierrejeambrun/orgs","repos_url":"https://api.github.com/users/pierrejeambrun/repos","events_url":"https://api.github.com/users/pierrejeambrun/events{/privacy}","received_events_url":"https://api.github.com/users/pierrejeambrun/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5442145319","html_url":"https://github.com/apache/airflow/issues/71499#issuecomment-5442145319","issue_url":"https://api.github.com/repos/apache/airflow/issues/71499","id":5442145319,"node_id":"IC_kwDOAgUK288AAAABRGCMJw","user":{"login":"stephen-bracken","id":18257727,"node_id":"MDQ6VXNlcjE4MjU3NzI3","avatar_url":"https://avatars.githubusercontent.com/u/18257727?v=4","gravatar_id":"","url":"https://api.github.com/users/stephen-bracken","html_url":"https://github.com/stephen-bracken","followers_url":"https://api.github.com/users/stephen-bracken/followers","following_url":"https://api.github.com/users/stephen-bracken/following{/other_user}","gists_url":"https://api.github.com/users/stephen-bracken/gists{/gist_id}","starred_url":"https://api.github.com/users/stephen-bracken/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stephen-bracken/subscriptions","organizations_url":"https://api.github.com/users/stephen-bracken/orgs","repos_url":"https://api.github.com/users/stephen-bracken/repos","events_url":"https://api.github.com/users/stephen-bracken/events{/privacy}","received_events_url":"https://api.github.com/users/stephen-bracken/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-27T16:31:26Z","updated_at":"2026-08-27T16:32:37Z","body":"From a multi-team perspective I am not sure what the value added by evaluating auth for every dag is, as we use team level access policies and split dags into separate sub-teams where needed. Perhaps there are other organisations where there is a need to have fine grained permissions at the individual dag level within teams but it feels like an anti-pattern to me. Keycloak policies also support resource URI wildcarding, so we could possibly convert the resource schema to use resource type identifiers like `/{team_name}/{resource}/{resource_id}` and `/{team_name}/{resource}/*`, which would allow bulk authorization decisions and also deny policies on specific dags.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5442145319/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"stephen-bracken","id":18257727,"node_id":"MDQ6VXNlcjE4MjU3NzI3","avatar_url":"https://avatars.githubusercontent.com/u/18257727?v=4","gravatar_id":"","url":"https://api.github.com/users/stephen-bracken","html_url":"https://github.com/stephen-bracken","followers_url":"https://api.github.com/users/stephen-bracken/followers","following_url":"https://api.github.com/users/stephen-bracken/following{/other_user}","gists_url":"https://api.github.com/users/stephen-bracken/gists{/gist_id}","starred_url":"https://api.github.com/users/stephen-bracken/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stephen-bracken/subscriptions","organizations_url":"https://api.github.com/users/stephen-bracken/orgs","repos_url":"https://api.github.com/users/stephen-bracken/repos","events_url":"https://api.github.com/users/stephen-bracken/events{/privacy}","received_events_url":"https://api.github.com/users/stephen-bracken/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5617749313","html_url":"https://github.com/apache/airflow/issues/71499#issuecomment-5617749313","issue_url":"https://api.github.com/repos/apache/airflow/issues/71499","id":5617749313,"node_id":"IC_kwDOAgUK288AAAABTtgNQQ","user":{"login":"stegololz","id":60776491,"node_id":"MDQ6VXNlcjYwNzc2NDkx","avatar_url":"https://avatars.githubusercontent.com/u/60776491?v=4","gravatar_id":"","url":"https://api.github.com/users/stegololz","html_url":"https://github.com/stegololz","followers_url":"https://api.github.com/users/stegololz/followers","following_url":"https://api.github.com/users/stegololz/following{/other_user}","gists_url":"https://api.github.com/users/stegololz/gists{/gist_id}","starred_url":"https://api.github.com/users/stegololz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stegololz/subscriptions","organizations_url":"https://api.github.com/users/stegololz/orgs","repos_url":"https://api.github.com/users/stegololz/repos","events_url":"https://api.github.com/users/stegololz/events{/privacy}","received_events_url":"https://api.github.com/users/stegololz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-10T11:11:23Z","updated_at":"2026-09-10T11:11:23Z","body":"For visibility, there's related work upstream on the Keycloak side:\n\n- [keycloak/keycloak#45311](https://github.com/keycloak/keycloak/issues/45311): a request for batch authorization through Keycloak's REST API, opened from the Airflow side citing this exact case (500+ DAGs meaning 500+ requests). Still open.\n- [keycloak/keycloak#49016](https://github.com/keycloak/keycloak/issues/49016): Keycloak tracking AuthZEN support as a technology preview. The AuthZEN spec includes an Access Evaluations (plural) API, i.e. batched authorization, which would address this properly. It's on the \"Future\" milestone with no target release, so we're waiting for a more mature version before implementing against it.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5617749313/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"stegololz","id":60776491,"node_id":"MDQ6VXNlcjYwNzc2NDkx","avatar_url":"https://avatars.githubusercontent.com/u/60776491?v=4","gravatar_id":"","url":"https://api.github.com/users/stegololz","html_url":"https://github.com/stegololz","followers_url":"https://api.github.com/users/stegololz/followers","following_url":"https://api.github.com/users/stegololz/following{/other_user}","gists_url":"https://api.github.com/users/stegololz/gists{/gist_id}","starred_url":"https://api.github.com/users/stegololz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/stegololz/subscriptions","organizations_url":"https://api.github.com/users/stegololz/orgs","repos_url":"https://api.github.com/users/stegololz/repos","events_url":"https://api.github.com/users/stegololz/events{/privacy}","received_events_url":"https://api.github.com/users/stegololz/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":30901094191,"node_id":"RTE_lADOAgUK288AAAABMdUR9s8AAAAHMdlHLw","url":"https://api.github.com/repos/apache/airflow/issues/events/30901094191","actor":{"login":"pierrejeambrun","id":14861206,"node_id":"MDQ6VXNlcjE0ODYxMjA2","avatar_url":"https://avatars.githubusercontent.com/u/14861206?v=4","gravatar_id":"","url":"https://api.github.com/users/pierrejeambrun","html_url":"https://github.com/pierrejeambrun","followers_url":"https://api.github.com/users/pierrejeambrun/followers","following_url":"https://api.github.com/users/pierrejeambrun/following{/other_user}","gists_url":"https://api.github.com/users/pierrejeambrun/gists{/gist_id}","sta