url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["airflow","apache","apache-airflow","automation","dag","data-engineering","data-integration","data-orchestrator","data-pipelines","data-science","elt","etl","machine-learning","mlops","orchestration","python","scheduler","workflow","workflow-engine","workflow-orchestration"],"visibility":"public","forks":18214,"open_issues":1927,"watchers":47308,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/apache/airflow/pulls/71978","html_url":"https://github.com/apache/airflow/pull/71978","diff_url":"https://github.com/apache/airflow/pull/71978.diff","patch_url":"https://github.com/apache/airflow/pull/71978.patch","merged_at":null},"body":"Backfills can now target a subset of a Dag's tasks via a `task_id_pattern` regular expression, instead of always covering the whole graph.\r\n\r\nMotivating cases from the issue: rebuilding one dataset among many written by a single Dag, and excluding a historical sensor whose external data has since been pruned and can no longer succeed.\r\n\r\n**Behaviour**\r\n- `task_id_pattern` is resolved to the matching task ids at creation time and persisted on the backfill (`selected_task_ids`), so the selection stays reproducible even if the Dag later changes.\r\n- The scheduler restricts the run to the selected tasks by pruning the run's Dag to that subset (reusing `SerializedDAG.partial_subset`). Dependencies on unselected upstream tasks are ignored, and run success is judged on the selected tasks alone.\r\n- Requests whose pattern matches no task are rejected (422); an invalid regex is rejected too.\r\n- Omitting the pattern backfills the whole Dag exactly as before — the new column is nullable, so existing backfills are unaffected.\r\n\r\nScope of this PR: model + migration + REST API + scheduler semantics + tests. CLI and UI form controls are intended as follow-ups.\r\n\r\ncloses: #70027\r\n\r\n---\r\n\r\n##### Was generative AI tooling used to co-author this PR?\r\n\r\n- [X] Yes — Claude Code \r\n","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/71978/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/71978/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":30495962796,"node_id":"SE_lADOAgUK288AAAABJNSrqs8AAAAHGbN2rA","url":"https://api.github.com/repos/apache/airflow/issues/events/30495962796","actor":{"login":"sarah-reddit","id":168122436,"node_id":"U_kgDOCgVYRA","avatar_url":"https://avatars.githubusercontent.com/u/168122436?v=4","gravatar_id":"","url":"https://api.github.com/users/sarah-reddit","html_url":"https://github.com/sarah-reddit","followers_url":"https://api.github.com/users/sarah-reddit/followers","following_url":"https://api.github.com/users/sarah-reddit/following{/other_user}","gists_url":"https://api.github.com/users/sarah-reddit/gists{/gist_id}","starred_url":"https://api.github.com/users/sarah-reddit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sarah-reddit/subscriptions","organizations_url":"https://api.github.com/users/sarah-reddit/orgs","repos_url":"https://api.github.com/users/sarah-reddit/repos","events_url":"https://api.github.com/users/sarah-reddit/events{/privacy}","received_events_url":"https://api.github.com/users/sarah-reddit/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2026-09-03T14:44:46Z","performed_via_github_app":null}]]
