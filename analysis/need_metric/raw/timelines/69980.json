andish/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2026-07-16T19:19:47Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/4996835068","html_url":"https://github.com/apache/airflow/issues/69980#issuecomment-4996835068","issue_url":"https://api.github.com/repos/apache/airflow/issues/69980","id":4996835068,"node_id":"IC_kwDOAgUK288AAAABKdWm_A","user":{"login":"seanmuth","id":12852047,"node_id":"MDQ6VXNlcjEyODUyMDQ3","avatar_url":"https://avatars.githubusercontent.com/u/12852047?v=4","gravatar_id":"","url":"https://api.github.com/users/seanmuth","html_url":"https://github.com/seanmuth","followers_url":"https://api.github.com/users/seanmuth/followers","following_url":"https://api.github.com/users/seanmuth/following{/other_user}","gists_url":"https://api.github.com/users/seanmuth/gists{/gist_id}","starred_url":"https://api.github.com/users/seanmuth/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanmuth/subscriptions","organizations_url":"https://api.github.com/users/seanmuth/orgs","repos_url":"https://api.github.com/users/seanmuth/repos","events_url":"https://api.github.com/users/seanmuth/events{/privacy}","received_events_url":"https://api.github.com/users/seanmuth/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-16T21:38:58Z","updated_at":"2026-07-16T21:38:58Z","body":"Here's a cleaner db-agnostic repair script to run in python, claude generated and not tested by me, just FYI, but applies the same fix over the data that the (fixed) migration would do:\n\n```python\nimport json\nfrom sqlalchemy import create_engine, text\n\ndef repair(node):\n    if isinstance(node, dict):\n        if \"__type\" in node and \"__var\" in node:\n            if node[\"__type\"] == \"dict\" and isinstance(node[\"__var\"], dict):\n                return {\"__type\": \"dict\", \"__var\": {k: repair(v) for k, v in node[\"__var\"].items()}}\n            return node\n        return {\"__type\": \"dict\", \"__var\": {k: repair(v) for k, v in node.items()}}\n    if isinstance(node, list):\n        return [repair(v) for v in node]\n    return node\n\neng = create_engine(\"mysql://…\")   # or postgresql://…\nwith eng.begin() as c:\n    rows = c.execute(text(\"SELECT id, data FROM callback\")).mappings().all()\n    for r in rows:\n        data = r[\"data\"] if isinstance(r[\"data\"], (dict, list)) else json.loads(r[\"data\"])\n        fixed = repair(data)\n        if fixed != data:\n            c.execute(text(\"UPDATE callback SET data = :d WHERE id = :i\"),\n                      {\"d\": json.dumps(fixed), \"i\": r[\"id\"]})\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/4996835068/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"seanmuth","id":12852047,"node_id":"MDQ6VXNlcjEyODUyMDQ3","avatar_url":"https://avatars.githubusercontent.com/u/12852047?v=4","gravatar_id":"","url":"https://api.github.com/users/seanmuth","html_url":"https://github.com/seanmuth","followers_url":"https://api.github.com/users/seanmuth/followers","following_url":"https://api.github.com/users/seanmuth/following{/other_user}","gists_url":"https://api.github.com/users/seanmuth/gists{/gist_id}","starred_url":"https://api.github.com/users/seanmuth/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/seanmuth/subscriptions","organizations_url":"https://api.github.com/users/seanmuth/orgs","repos_url":"https://api.github.com/users/seanmuth/repos","events_url":"https://api.github.com/users/seanmuth/events{/privacy}","received_events_url":"https://api.github.com/users/seanmuth/received_events","type":"User","user_view_type":