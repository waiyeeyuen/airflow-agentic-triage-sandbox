.github.com/repos/apache/airflow/milestones{/number}","notifications_url":"https://api.github.com/repos/apache/airflow/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/apache/airflow/labels{/name}","releases_url":"https://api.github.com/repos/apache/airflow/releases{/id}","deployments_url":"https://api.github.com/repos/apache/airflow/deployments","created_at":"2015-04-13T18:04:58Z","updated_at":"2026-10-29T14:39:15Z","pushed_at":"2026-10-29T14:39:07Z","git_url":"git://github.com/apache/airflow.git","ssh_url":"git@github.com:apache/airflow.git","clone_url":"https://github.com/apache/airflow.git","svn_url":"https://github.com/apache/airflow","homepage":"https://airflow.apache.org/","size":790917,"stargazers_count":47308,"watchers_count":47308,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":18214,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1927,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["airflow","apache","apache-airflow","automation","dag","data-engineering","data-integration","data-orchestrator","data-pipelines","data-science","elt","etl","machine-learning","mlops","orchestration","python","scheduler","workflow","workflow-engine","workflow-orchestration"],"visibility":"public","forks":18214,"open_issues":1927,"watchers":47308,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/apache/airflow/pulls/71926","html_url":"https://github.com/apache/airflow/pull/71926","diff_url":"https://github.com/apache/airflow/pull/71926.diff","patch_url":"https://github.com/apache/airflow/pull/71926.patch","merged_at":"2026-09-10T08:35:12Z"},"body":"closes: #71921\n\n## Summary\n\nMigration 0049 quotes non-finite floats before the `bytea -> JSONB` cast:\n\n```sql\nregexp_replace(txt, '([:,\\[]\\s*|^)(NaN|-?Infinity)(?=\\s*[,}\\]]|$)', '\\1\"\\2\"', 'g')\n```\n\nThe quotes are unescaped, which is only valid at the top level of a JSON document. When a task\npushes already-serialized JSON the value is a JSON string whose interior quotes are\nbackslash-escaped, so `\\\"commission\\\": NaN}` becomes `\\\"commission\\\": \"NaN\"}`. The raw quote closes\nthe wrapping string, the following `NaN` is left bare, and the cast aborts:\n\n```\nDETAIL:  Token \"NaN\" is invalid.\nCONTEXT:  JSON data, line 1: \"{\\\"amount\\\": 604441.0, \\\"commission\\\": \"NaN...\n```\n\nThe sanitizer is what creates the invalid JSON. The stored bytea is exactly what Airflow 2's\n`json.dumps` wrote and it casts fine before sanitization. #53812, #57614, #57866, #62686 and #69064\neach refined *which* tokens match, never the replacement, so no release fixes this.\n\n## Fix\n\nTwo statements per dialect instead of one nested expression:\n\n1. Strip the U+0000 escape, unconditionally, on rows that contain it.\n2. Rewrite non-finite floats to bare `null`, only on rows that do not already parse as JSON.\n\nIf a value parses, its `NaN` can only be inside a string, so it is left byte for byte alone. Rows\nthat do need the rewrite get `null`, because a value can be invalid at the top level *and* wrap an\nescaped document, and only `null` is valid at any depth. Order matters: strip first, or a value\ninvalid only because of the escape looks like it needs the rewrite.\n\n| Dialect | Validity guard |\n|:---|:---|\n| PostgreSQL | session-local `pg_temp` function; `pg_input_is_valid` is 16+ and 14 is still supported |\n| MySQL | native `JSON_VALID()` |\n| SQLite | native `json_valid()`, with a JSON1 probe and unguarded fallback as in migration 0117 |\n\nMySQL had a second bug the new tests exposed: `[ ]*` sat outside group 1, so the replacement dropped\nthe space after the delimiter. Harmless in a top-level document, not when the document is itself a\nJSON string. Migration 0055 is unaffected and changes only a comment.\n\n**Behaviour change**: a top-level non-finite float becomes `null` instead of `\"NaN\"`, and one inside a\nJSON string is now left alone. Only affects deployments yet to run the 2.x -> 3.x upgrade.\n\n## Relationship to #71927\n\nSame guard idea, reached independently. Three things I ran locally rather than read off the diff:\n\n- Its PostgreSQL branch calls `json_valid()`, which does not exist in PostgreSQL: `ERROR: function\n  json_valid(text) does not exist` on 16.15. Every PostgreSQL upgrade would abort, NaN or not.\n- It guards the NUL strip too. `{\"note\": \"x\\^@y\"}` is valid `json` but not valid `jsonb`, so the row\n  is skipped as already-valid then rejected by the cast, undoing #69064.\n- A value invalid at the top level that also wraps an escaped document still goes through the\n  unchanged quoting regex and comes out corrupt.\n\nThe guard is their idea and it is the right one; this adopts it with those fixed.\n\n## Tests\n\nSix rows through the real per-dialect SQL on all three backends: the token classes plus an embedded\nNUL, a literal backslash-u-0000 that must survive, a serialized document as the whole value, one\nunder a dict key, one invalid at the top level *and* wrapping a document, and one invalid only\nbecause of the NUL escape, which pins the statement order. The already-valid rows assert unchanged\nbytes and compare the inner document as an exact string, so dropped whitespace fails instead of\nslipping past `json.loads`. One more test covers the no-JSON1 SQLite path.\n\nRan the statements directly against PostgreSQL 14.23, PostgreSQL 16.15 and MySQL 8.4: 6/6 rows\nbyte-exact and casting cleanly on each. Breeze `core-tests --backend postgres --python 3.10` passes.\nOn `main` the same fixtures reproduce the production failure.\n","reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/71926/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/apache/airflow/issues/71926/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5366993223","html_url":"https://github.com/apache/airflow/issues/71921#issuecomment-5366993223","issue_url":"https://api.github.com/repos/apache/airflow/issues/71921","id":5366993223,"node_id":"IC_kwDOAgUK288AAAABP-XRRw","user":{"login":"waterWang","id":6082925,"node_id":"MDQ6VXNlcjYwODI5MjU=","avatar_url":"https://avatars.githubusercontent.com/u/6082925?v=4","gravatar_id":"","url":"https://api.github.com/users/waterWang","html_url":"https://github.com/waterWang","followers_url":"https://api.github.com/users/waterWang/followers","following_url":"https://api.github.com/users/waterWang/following{/other_user}","gists_url":"https://api.github.com/users/waterWang/gists{/gist_id}","starred_url":"https://api.github.com/users/waterWang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/waterWang/subscriptions","organizations_url":"https://api.github.com/users/waterWang/orgs","repos_url":"https://api.github.com/users/waterWang/repos","events_url":"https://api.github.com/users/waterWang/events{/privacy}","received_events_url":"https://api.github.com/users/waterWang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-21T07:56:18Z","updated_at":"2026-08-21T07:56:18Z","body":"PR #71927 — `json_valid()` guard prevents NaN sanitizer from corrupting JSON string values.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5366993223/reactions","total_count":0,"+1":0,"-1":0,"laugh":0