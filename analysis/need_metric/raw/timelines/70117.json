sers/PrafullPandey06/events{/privacy}","received_events_url":"https://api.github.com/users/PrafullPandey06/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5035344622","html_url":"https://github.com/apache/airflow/issues/70117#issuecomment-5035344622","issue_url":"https://api.github.com/repos/apache/airflow/issues/70117","id":5035344622,"node_id":"IC_kwDOAgUK288AAAABLCFC7g","user":{"login":"Andrushika","id":69671930,"node_id":"MDQ6VXNlcjY5NjcxOTMw","avatar_url":"https://avatars.githubusercontent.com/u/69671930?v=4","gravatar_id":"","url":"https://api.github.com/users/Andrushika","html_url":"https://github.com/Andrushika","followers_url":"https://api.github.com/users/Andrushika/followers","following_url":"https://api.github.com/users/Andrushika/following{/other_user}","gists_url":"https://api.github.com/users/Andrushika/gists{/gist_id}","starred_url":"https://api.github.com/users/Andrushika/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Andrushika/subscriptions","organizations_url":"https://api.github.com/users/Andrushika/orgs","repos_url":"https://api.github.com/users/Andrushika/repos","events_url":"https://api.github.com/users/Andrushika/events{/privacy}","received_events_url":"https://api.github.com/users/Andrushika/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-21T14:35:34Z","updated_at":"2026-07-21T14:35:34Z","body":"> I see a fix being raised [#70163](https://github.com/apache/airflow/pull/70163) for the same issue and it looks like init process is reaping the supervisor's child process.\n\nNo, that PR is re-describing the error path in this issue, not because another user encountered it. (it does not show that dumb-init actually reaped the task process.)\n\n> I am not sure if this error path is correct, since init should only be able to reap the orphan process.\n\nThis is because the mechanism of `init`: the supervisor directly forks the task process, so the task is its child. As long as the supervisor is still alive, PID 1 should not be able to reap it unless the task was somehow reparented.\n\nI agree that these steps reproduce the lingering supervisors, but I do not think they identify the root cause yet.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5035344622/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"Andrushika","id":69671930,"node_id":"MDQ6VXNlcjY5NjcxOTMw","avatar_url":"https://avatars.githubusercontent.com/u/69671930?v=4","gravatar_id":"","url":"https://api.github.com/users/Andrushika","html_url":"https://github.com/Andrushika","followers_url":"https://api.github.com/users/Andrushika/followers","following_url":"https://api.github.com/users/Andrushika/following{/other_user}","gists_url":"https://api.github.com/users/Andrushika/gists{/gist_id}","starred_url":"https://api.github.com/users/Andrushika/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Andrushika/subscriptions","organizations_url":"https://api.github.com/users/Andrushika/orgs","repos_url":"https://api.github.com/users/Andrushika/repos","events_url":"https://api.github.com/users/Andrushika/events{/privacy}","received_events_url":"https://api.github.com/users/Andrushika/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":28332080395,"node_id":"RTE_lADOAgUK288AAAABJa9xKs8AAAAGmLk9Cw","url":"https://api.github.com/repos/apache/airflow/issues/events/28332080395","actor":{"login":"PrafullPandey06","id":63739086,"node_id":"MDQ6VXNlcjYzNzM5MDg2","avatar_url":"https://avatars.githubusercontent.com/u/63739086?v=4","gravatar_id":"","url":"https://api.github.com/users/PrafullPandey06","html_url":"https://github.com/PrafullPandey06","followers_url":"https://api.github.com/users/PrafullPandey06/followers","following_url":"https://api.github.com/users/PrafullPandey06/following{/other_user}","gists_url":"https://api.github.com/users/PrafullPandey06/gists{/gist_id}","starred_url":"https://api.github.com/users/PrafullPandey06/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PrafullPandey06/subscriptions","organizations_url":"https://api.github.com/users/PrafullPandey06/orgs","repos_url":"https://api.github.com/users/PrafullPandey06/repos","events_url":"https://api.github.com/users/PrafullPandey06/events{/privacy}","received_events_url":"https://api.github.com/users/PrafullPandey06/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2026-07-22T14:41:38Z","rename":{"from":"Task supervisor lingers indefinitely on CeleryExecutor with dumb-init (socket_cleanup_timeout never triggers)","to":"Task supervisor lingers indefinitely on CeleryExecutor when psutil.Process.wait() returns None (socket_cleanup_timeout never triggers)"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5047615518","html_url":"https://github.com/apache/airflow/issues/70117#issuecomment-5047615518","issue_url":"https://api.github.com/repos/apache/airflow/issues/70117","id":5047615518,"node_id":"IC_kwDOAgUK288AAAABLNyAHg","user":{"login":"PrafullPandey06","id":63739086,"node_id":"MDQ6VXNlcjYzNzM5MDg2","avatar_url":"https://avatars.githubusercontent.com/u/63739086?v=4","gravatar_id":"","url":"https://api.github.com/users/PrafullPandey06","html_url":"https://github.com/PrafullPandey06","followers_url":"https://api.github.com/users/PrafullPandey06/followers","following_url":"https://api.github.com/users/PrafullPandey06/following{/other_user}","gists_url":"https://api.github.com/users/PrafullPandey06/gists{/gist_id}","starred_url":"https://api.github.com/users/PrafullPandey06/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PrafullPandey06/subscriptions","organizations_url":"https://api.github.com/users/PrafullPandey06/orgs","repos_url":"https://api.github.com/users/PrafullPandey06/repos","events_url":"https://api.github.com/users/PrafullPandey06/events{/privacy}","received_events_url":"https://api.github.com/users/PrafullPandey06/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-22T14:44:34Z","updated_at":"2026-07-22T14:46:05Z","body":"You're right I shouldn't have stated the dumb-init reaping path as confirmed root cause. I don't have strace evidence showing PID 1 actually calling waitpid on the task PID, and as you pointed out, that shouldn't normally happen while the supervisor is alive. I've updated the issue title and description to reflect this.\n\nThat said, the hang is reproducible and the impact is real  26–30 stuck supervisors accumulating ~8–10 GB of wasted memory per worker pod. Whatever is causing wait(timeout=0) to return None, the supervisor doesn't handle that case, and the cleanup timeout has no independent fallback.\n\nYour reproduction script confirms the exact code gap  _check_subprocess_exit only handles an int return or TimeoutExpired, so None is silently ignored. \n\nalso agreed on the label suggestions , affected_version:main_branch, area:task-sdk, and removing area:performance. I don't have permissions to update labels, could a maintainer apply these?\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5047615518/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"PrafullPandey06","id":63739086,"node_id":"MDQ6VXNlcjYzNzM5MDg2","avatar_url":"https://avatars.githubusercontent.com/u/63739086?v=4","gravatar_id":"","url":"https://api.github.com/users/PrafullPandey06","html_url":"https://github.com/PrafullPandey06","followers_url":"https://api.github.com/users/PrafullPandey06/followers","following_url":"https://api.github.com/users/PrafullPandey06/following{/other_user}","gists_url":"https://api.github.com/users/PrafullPandey06/gists{/gist_id}","starred_url":"https://api.github.com/users/PrafullPandey06/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/PrafullPandey06/subscriptions","organizations_url":"https://api.github.com/users/PrafullPandey06/orgs","repos_url":"https://api.github.com/users/PrafullPandey06/repos","events_url":"https://api.github.com/users/PrafullPandey06/events{/privacy}","received_events_url":"https://api.github.com/users/PrafullPandey06/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5070476938","html_url":"https://github.com/apache/airflow/issues/70117#issuecomment-5070476938","issue_url":"https://api.github.com/repos/apache/airflow/issues/70117","id":5070476938,"node_id":"IC_kwDOAgUK288AAAABLjlWig","user":{"login":"hooiv","id":125276621,"node_id":"U_kgDOB3eRzQ","avatar_url":"https://avatars.githubusercontent.com/u/125276621?v=4","gravatar_id":"","url":"https://api.github.com/users/hooiv","html_url":"https://github.com/hooiv","followers_url":"https://api.github.com/users/hooiv/followers","following_url":"https://api.github.com/users/hooiv/following{/other_user}","gists_url":"https://api.github.com/users/hooiv/gists{/gist_id}","starred_url":"https://api.github.com/users/hooiv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hooiv/subscriptions","organizations_url":"https://api.github.com/users/hooiv/orgs","repos_url":"https://api.github.com/users/hooiv/repos","events_url":"https://api.github.com/users/hooiv/events{/privacy}","received_events_url":"https://api.github.com/users/hooiv/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-07-24T13:38:51Z","updated_at":"2026-07-24T13:38:51Z","body":"I've tracked down the actual root cause of the missing exit status\n\nYou were completely right that `dumb-init` couldn't be reaping the process while the parent supervisor was still alive. It turns out the culprit was **Celery's `billiard` library**. \n\nBecause `CeleryExecutor` runs the supervisor entrypoint directly inside the Celery worker process, it inherits `billiard`'s aggressive global `SIGCHLD` signal handler. Whenever the Airflow task subprocess finishes, `billiard` intercepts the signal and calls `waitpid(-1, WNOHANG)`. This silently eats the exit status before the Task SDK's `psutil.wait(timeout=0)` ever gets a chance to see it, resulting in a return value of `None`.\n\nI've updated PR #70163 with a fix that simply resets `SIGCHLD` to `SIG_DFL` inside `celery_executor_utils.py` right before the supervisor executes. This stops `billiard` from interfering and perfectly resolves the hanging supervisors","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/apache/airflow/issues/comments/5070476938/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"hooiv","id":125276621,"node_id":"U_kgDOB3eRzQ","avatar_url":"https://avatars.githubusercontent.com/u/125276621?v=4","gravatar_id":"","url":"https://api.github.com/users/hooiv","html_url":"https://github.com/hooiv","followers_url":"https://api.github.com/users/hooiv/followers","following_url":"https://api.github.com/users/hooiv/following{/other_user}","gists_url":"https://api.github.com/users/hooiv/gists{/gist_id}","starred_url":"https://api.github.com/users/hooiv/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hooiv/subscriptions","organizations_url":"https://api.github.com/users/hooiv/orgs","repos_url":"https://api.github.com/users/hooiv/repos","events_url":"https://api.github.com/users/hooiv/events{/privacy}","received_events_url":"https://api.github.com/users/hooiv/received_events","type":"User","user_view_type":"public","site_admin":false}},{"actor":{"login":"Andrushika","id":69671930,"node_id":"MDQ6VXNlcjY5NjcxOTMw","avatar_url":"https://avatars.githubusercontent.com/u/69671930?v=4","gravatar_id":"","url":"https://api.github.com/users/Andrushika","html_url":"https://github.com/Andrushika","followers_url":"https://api.github.com/users/Andrushika/followers","following_url":"https://api.github.com/users/Andrushika/following{/other_user}","gists_url":"https://api.github.com/users/Andrushika/gists{/gist_id}","starred_url":"https://api.github.com/users/Andrushika/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Andrushika/subscriptions","organizations_url":"https://api.github.com/users/Andrushika/orgs","repos_url":"https://api.github.com/users/Andrushika/repos","events_url":"https://api.github.com/users/Andrushika/events{/privacy}","received_events_url":"https://api.github.com/users/Andrushika/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-08T13:48:31Z","updated_at":"2026-10-08T13:48:31Z","source":{"type":"issue","issue":{"url":"https://api.github.com/repos/opensource4you/readme/issues/28","repository_url":"https://api.github.com/repos/opensource4you/readme","labels_url":"https://api.github.com/repos/opensource4you/readme/issues/28/labels{/name}","comments_url":"https://api.github.com/repos/opensource4you/readme/issues/28/comments","events_url":"https://api.github.com/repos/opensource4you/readme/issues/28/events","html_url":"https://github.com/opensource4you/readme/pull/28","id":5762955289,"node_id":"PR_kwDOMcbrhc8AAAABHV_Tdg","number":28,"title":"Add Andrushika's June to October contribution report for apache-airflow","user":{"login":"Andrushika","id":69671930,"node_id":"